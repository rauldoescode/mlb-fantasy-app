# Copy to .env and fill in your values. Never commit .env.

# Used by the Python data worker (psycopg2 / libpq URL form).
DATABASE_URL=postgresql://user:password@host:port/postgres

# Used by the Java league-engine (JDBC URL form; credentials go in the query string).
JDBC_DATABASE_URL=jdbc:postgresql://host:port/postgres?user=user&password=password

# Secret used by the league-engine to sign JWTs. Must be at least 32 characters.
JWT_SECRET=change-me-in-production-use-at-least-256-bits-long-secret
